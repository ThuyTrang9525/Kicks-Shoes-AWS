# CI/CD should inject this dynamically at deploy time.
container_image = "123456789012.dkr.ecr.us-west-2.amazonaws.com/kicks-shoes-backend:sha-abcdef0"

# Secret that stores app runtime configuration.
app_config_secret_arn = "arn:aws:secretsmanager:us-west-2:123456789012:secret:kicks/prod/app-config-abc123"
app_config_secret_keys = [
  "JWT_SECRET",
  "JWT_REFRESH_SECRET",
  "MONGODB_URI",
  "GOOGLE_AI_API_KEY"
]

# Optional overrides
# project_name = "kicks-shoes-prod"
# aws_region   = "us-west-2"
# desired_count = 2
# autoscaling_min = 2
# autoscaling_max = 6
